{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musicmatch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "05085d6dc2a4466cadd7fc410f52b8cd"
    }
  ]
}
